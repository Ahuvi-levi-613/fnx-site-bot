# Copy to .env and fill in. Never commit .env.

# --- Stage 1: crawl ---
# Firecrawl (free tier: 1,000 pages/month). Leave empty to use the built-in fallback fetcher.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1

# Polite crawling
CRAWL_DELAY_SECONDS=1.5
CRAWL_MAX_PAGES=300
CRAWL_USER_AGENT=fnx-site-bot/0.1 (hackathon research; contact via GitHub)

# --- Later stages (not used yet) ---
GEMINI_API_KEY=
COHERE_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Backup LLM keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
