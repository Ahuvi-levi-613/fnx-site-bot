# Copy to .env and fill in. Never commit .env.

# --- Day 1: crawl ---
# Firecrawl (free tier: 1,000 pages/month). Leave empty to use the built-in fallback fetcher.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1

# Polite crawling
CRAWL_DELAY_SECONDS=1.5
CRAWL_MAX_PAGES=300
CRAWL_USER_AGENT=fnx-site-bot/0.1 (hackathon research; contact via GitHub)

# --- Day 1: index (Voyage AI -> local Chroma in data/chroma) ---
# Gemini Embedding 2 is the SPEC primary but its free tier caps at 1,000 requests/day;
# build_index.py uses Voyage (SPEC backup) instead. GeminiEmbedder is still in embed.py/tested.
# Voyage: without a payment method on file it throttles to 3 requests/min and 10K tokens/min -
# add a card at dashboard.voyageai.com (Billing). The 200M free tokens still apply either way;
# a card only removes the throttle, it does not spend money within that allowance.
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3.5
VOYAGE_EMBED_DIM=1024
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIM=768

# --- Day 2: answer layer ---
# Rerank (SPEC: Cohere trial key)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# LLM: Gemini Flash primary, falls back to Groq then OpenRouter on error/429
GEMINI_LLM_MODEL=gemini-3.6-flash
# Groq: the key works, but on this dev machine the NetFree filter blocks POST requests to
# Groq's chat/completions endpoint specifically (GET, e.g. listing models, goes through fine).
# The code still tries it before OpenRouter, but don't rely on it actually answering here.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=recursive/flint-v1.0:free
